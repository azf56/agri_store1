# =============================================================================
# تنظیمات محیطی سامانه نهاده‌های کشاورزی (کود، سم، بذر) - Agri Inputs Store
# =============================================================================

# 1. تنظیمات سرور و پورت (cPanel Node.js Application Manager)
PORT=3000
NODE_ENV=production
BASE_URL=https://api.shop.avinia.ir

# 2. مبداهای مجاز CORS (جداسازی با کاما بدون فاصله اضافه)
# در محیط پروداکشن دامنه فروشگاه و ساب‌دامین API باید تعریف شوند:
ALLOWED_ORIGINS=https://shop.avinia.ir,https://api.shop.avinia.ir

# 3. تنظیمات پایگاه داده MySQL (cPanel MySQL Database Wizard)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=avinia_agristore
DB_USER=avinia_dbuser
DB_PASSWORD=YOUR_STRONG_MYSQL_PASSWORD_HERE
DB_DIALECT=mysql
# در پروداکشن فال‌بک به SQLite غیرفعال شود (false)
DB_ENABLE_SQLITE_FALLBACK=false

# 4. کلیدهای امنیتی احراز هویت (JWT)
# هشدار امنیتی: در محیط پروداکشن (NODE_ENV=production) تنظیم این متغیر الزامی است؛
# در صورت خالی بودن، سرور برای حفظ امنیت متوقف می‌شود.
JWT_SECRET=YOUR_VERY_LONG_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_HERE
JWT_EXPIRES_IN=7d

# 5. مشخصات اولیه ایجاد مدیر سیستم (برای اجرای اسکریپت create-admin.js در محیط پروداکشن)
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=YOUR_SUPER_ADMIN_PASSWORD_HERE
ADMIN_NAME=مدیر ارشد فروشگاه نهاده‌های کشاورزی
ADMIN_LOCATION=دفتر مرکزی تهران / استان البرز

# 6. متغیرهای سمت فرانت‌اند کلاینت (Vite)
VITE_API_BASE_URL=https://api.shop.avinia.ir
VITE_SITE_URL=https://shop.avinia.ir
VITE_BACKEND_PROXY_URL=http://localhost:3000

# 7. سقف حجم فایل‌های آپلود
UPLOAD_MAX_IMAGE_SIZE_MB=5
UPLOAD_MAX_MSDS_SIZE_MB=10
