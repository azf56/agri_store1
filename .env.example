# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=*

# MySQL Database Configuration (cPanel / Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agri_store_db
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
# Set to true to use SQLite fallback if MySQL is unreachable during development
DB_ENABLE_SQLITE_FALLBACK=true

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_for_agri_store_2026_change_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_MAX_SIZE_MB=5

# AI Studio App Hosting URL
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
