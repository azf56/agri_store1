# Server & Domain Configuration
PORT=3000
NODE_ENV=development
BASE_URL=https://api.shop.avinia.ir
ALLOWED_ORIGINS=https://shop.avinia.ir,http://shop.avinia.ir,https://api.shop.avinia.ir,http://api.shop.avinia.ir,http://localhost:3000,http://localhost:5173

# Frontend (Vite) Configuration for shop.avinia.ir
VITE_API_BASE_URL=https://api.shop.avinia.ir
VITE_SITE_URL=https://shop.avinia.ir
VITE_BACKEND_PROXY_URL=http://localhost:3000

# MySQL Database Configuration (cPanel / Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=avinia_agristore
DB_USER=avinia_dbuser
DB_PASSWORD=
DB_DIALECT=mysql
# Set to true to use SQLite fallback if MySQL is unreachable during development
DB_ENABLE_SQLITE_FALLBACK=true

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_for_agri_store_2026_change_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_MAX_SIZE_MB=10

# AI Studio App Hosting URL
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
